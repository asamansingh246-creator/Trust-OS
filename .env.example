# TrustOS Environment Configuration (Placeholder Values Only — Never Commit Secrets)
TRUSTOS_PG_HOST=127.0.0.1
TRUSTOS_PG_PORT=5433
TRUSTOS_PG_DB=trustos_db

# Database Owner DSN (Used ONLY for schema migrations and initial seeding)
TRUSTOS_OWNER_DSN=host=127.0.0.1 port=5433 dbname=trustos_db user=postgres password=CHANGE_ME_OWNER_PASSWORD

# Restricted Application Role DSN (NOSUPERUSER, NOBYPASSRLS — Used for all application queries)
TRUSTOS_APP_DSN=host=127.0.0.1 port=5433 dbname=trustos_db user=trustos_app password=CHANGE_ME_APP_PASSWORD

# Server-Side Authentication Secret
TRUSTOS_JWT_SECRET=CHANGE_ME_GENERATE_A_256_BIT_RANDOM_SECRET
